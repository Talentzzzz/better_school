<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.inventory</groupId>
        <artifactId>inventory-l2w256</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>l2w256-app</artifactId>
    <name>l2w256-app</name>
    <description>应用启动层：Application + config Bean 装配 + MyBatis mapper XML 唯一存放处</description>

    <dependencies>
        <dependency>
            <groupId>cn.inventory</groupId>
            <artifactId>l2w256-trigger</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.inventory</groupId>
            <artifactId>l2w256-infrastructure</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.inventory</groupId>
            <artifactId>l2w256-api</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.inventory</groupId>
            <artifactId>l2w256-types</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 参数校验实现（api 模块只声明注解，实现只落在启动层） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 只为一件事：运行期实时采 JVM / GC / 连接池 / 积压指标 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>l2w256-app</finalName>
        <plugins>
            <!-- repackage 已由 spring-boot-starter-parent 绑定到 package，重复声明 execution 会打两次包 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
