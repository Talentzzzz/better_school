<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.betterschool</groupId>
        <artifactId>timeout-center</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>timeout-center-app</artifactId>
    <name>timeout-center-app</name>

    <dependencies>
        <dependency>
            <groupId>com.betterschool</groupId>
            <artifactId>timeout-center-trigger</artifactId>
        </dependency>
        <dependency>
            <groupId>com.betterschool</groupId>
            <artifactId>timeout-center-infrastructure</artifactId>
        </dependency>
        <dependency>
            <groupId>com.betterschool</groupId>
            <artifactId>timeout-center-case</artifactId>
        </dependency>
        <dependency>
            <groupId>com.betterschool</groupId>
            <artifactId>timeout-center-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.betterschool</groupId>
            <artifactId>timeout-center-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>com.betterschool</groupId>
            <artifactId>timeout-center-types</artifactId>
        </dependency>
        <!-- 扫描 job（分片广播）：执行器 appname/port/log-path 与其余三服务错开 -->
        <dependency>
            <groupId>com.xuxueli</groupId>
            <artifactId>xxl-job-core</artifactId>
        </dependency>
        <!-- 分片驱动：datasource.url 指向 classpath:sharding.yaml -->
        <dependency>
            <groupId>org.apache.shardingsphere</groupId>
            <artifactId>shardingsphere-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.shardingsphere</groupId>
            <artifactId>shardingsphere-sharding-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.shardingsphere</groupId>
            <artifactId>shardingsphere-infra-url-classpath</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.shardingsphere</groupId>
            <artifactId>shardingsphere-infra-data-source-pool-hikari</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.shardingsphere</groupId>
            <artifactId>shardingsphere-standalone-mode-repository-memory</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.shardingsphere</groupId>
            <artifactId>shardingsphere-authority-simple</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.shardingsphere</groupId>
            <artifactId>shardingsphere-parser-sql-engine-mysql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.shardingsphere</groupId>
            <artifactId>shardingsphere-parser-sql-engine-sql92</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 集成测试：连 scripts/test-env.sh 起好的常驻栈（bs_timeout_test 库） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
