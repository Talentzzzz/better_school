-    /**
-     * 把同一条 UPDATE 命中的明细钉到同一个秒格（一次 NOW() 求值），避免多行分几次 INSERT 时
-     * 恰好跨秒、把「同一格」拆成两格（会让用例偶发不稳）。offset 负数 = 已封口，正数 = 未封口。
-     */
-    private void pinQuotaDetailTime(int offsetSeconds, Long... bizIds) {
-        String placeholders = String.join(",", java.util.Collections.nCopies(bizIds.length, "?"));
-        Object[] args = new Object[bizIds.length + 1];
-        args[0] = offsetSeconds;
-        System.arraycopy(bizIds, 0, args, 1, bizIds.length);
-        jdbcTemplate.update("""
-                UPDATE physical_marketing_quota_detail
-                SET create_time = TIMESTAMPADD(SECOND, ?, NOW())
-                WHERE biz_id IN (%s)
-                """.formatted(placeholders), args);
-    }
