+/**
+ * 库存配额实现：两段共用一套骨架，唯一的段相关差异都在仓储里（目标表 / 桶 key / 明细多一列 {@code type}）。
+ * <pre>
+ * 预扣：查台账（不存在 → INVENTORY_PARAM_ERROR；非 open → 走重放预检）→ 逐桶 Lua（扣 + 落明细）
+ * 兜底：主档扣不出 → 换个 inv_id（可换段）再扣一次，两段都扣不出 = FAILED
+ * 确认：仅实物段，仓储里的 waiting → issued 守卫转移（一个域内事务）
+ * </pre>
+ * 业务身份：明细带 {@code bizType} 与 {@code bizId = recordId}，唯一键保证同一笔业务只落一行。
+ * **撞键不是错误**——撞键 = 这条流转已落过（同 token 并发双击的第二笔），回补本次 Redis 扣减后按
+ * 「成功回放」返回 true；其它异常仍是回补后抛出。
+ * <p>
+ * 撞键之外还有一条更窄的重放窗口：同 token 的下一笔晚到、桶已被上一笔扣空（或台账已非 open）时，
+ * 根本走不到 INSERT。因此**扣不出时会再做一次业务幂等预检**，命中即按成功回放。兜底段同样查一次，
+ * 避免同一 {@code bizId} 在主档与兜底两张表各扣一份（跨表唯一键拦不住）。
+ */
+@Slf4j
+@Service
+@RequiredArgsConstructor
+public class InventoryQuotaServiceImpl implements IInventoryQuotaService {
+
+    private final IInventoryRepository inventoryRepository;
+    private final IInventoryBucketPort inventoryBucketPort;
+
+    @Override
+    public boolean preDeduct(InventorySegmentVO segment, long invId, long quantity, String bizType, long bizId) {
+        InventoryLedgerVO ledger = inventoryRepository.queryLedger(segment, invId);
+        if (ledger == null) {
+            throw new AppException(ResponseCode.INVENTORY_PARAM_ERROR.getCode(),
+                    "库存不存在 segment=" + segment.getCode() + " invId=" + invId);
+        }
+        if (!ledger.isOpen()) {
+            return replayed(segment, invId, bizType, bizId);
+        }
+        List<Integer> bucketIds = inventoryRepository.listBuckets(segment, invId).stream()
+                .map(InventoryBucketVO::bucketId)
+                .toList();
+        for (Integer bucketId : bucketIds) {
+            String bucketKey = Constants.bucketKey(segment, invId, bucketId);
+            if (!inventoryBucketPort.tryDeduct(bucketKey, quantity)) {
+                continue;
+            }
+            try {
+                inventoryRepository.insertDeductDetail(segment,
+                        new InventoryDeductDetailVO(invId, bucketId, quantity, bizType, bizId));
+                log.info("库存预扣成功 segment={} invId={} bucketId={} quantity={} bizType={} bizId={}",
+                        segment.getCode(), invId, bucketId, quantity, bizType, bizId);
+                return true;
+            } catch (DuplicateKeyException e) {
+                // 撞业务唯一键 = 同一笔预扣已落过（并发双击的第二笔）：回补本次 Redis 扣减，按成功回放
+                inventoryBucketPort.release(bucketKey, quantity);
+                log.info("库存预扣撞业务唯一键，回补 Redis 后按成功回放 segment={} invId={} bucketId={}"
+                                + " quantity={} bizType={} bizId={}",
+                        segment.getCode(), invId, bucketId, quantity, bizType, bizId);
+                return true;
+            } catch (RuntimeException e) {
