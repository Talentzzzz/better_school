+package com.betterschool.marketing.domain.inventory.service;
+
+import com.betterschool.marketing.domain.inventory.model.valobj.DeductOutcomeVO;
+import com.betterschool.marketing.domain.inventory.model.valobj.InventoryDeductRequestVO;
+import com.betterschool.marketing.types.inventory.InventorySegmentVO;
+
+/**
+ * 库存配额服务：两段（虚拟库存配额 / 实物营销配额）**一条路径**，段由 {@link InventorySegmentVO} 选。
+ * <p>
+ * 扣减路径 = 校验台账 → 逐桶 Lua 原子递减 Redis（桶内数量以 Redis 为权威）→ 落明细 {@code state = 0}。
+ * 同一步**不碰 DB 台账**——台账由合并任务按时间格异步结算（spec §5）。
+ * <p>
+ * 两段唯一的分叉在兑换确认：实物 {@code surplus → waiting → issued}（用户兑换后才转 issued），
+ * 虚拟 {@code surplus → issued}（没有等待态，也没有确认动作）。
+ * <p>
+ * 业务身份：明细带 {@code bizType} 与 {@code bizId}（抽奖 = {@code draw_record.record_id}），
+ * 唯一键保证同一笔业务只落一行。**撞键不是错误**——撞键 = 这条流转已落过（同 token 并发双击的第二笔），
+ * 回补本次 Redis 扣减后按「成功回放」返回 true；其它异常仍是回补后抛出。
+ * 撞键之外还有一条更窄的重放窗口（桶被上一笔扣空 / 台账已 exhausted，根本走不到 INSERT），
+ * 因此**扣不出时会再做一次业务幂等预检**，命中即按成功回放。
+ */
+public interface IInventoryQuotaService {
+
+    /**
+     * 预扣 quantity 份，并把业务身份 {@code (bizType, bizId)} 写进明细。
+     *
+     * @param segment 目标段：QUOTA = 实物营销配额，VIRTUAL = 虚拟库存配额
+     * @param bizType {@code InventoryBizTypes} 的取值（抽奖域不认识库存列，由库存侧端口实现填）
+     * @param bizId   业务 ID（抽奖 = {@code draw_record.record_id}）：明细唯一键的去重锚点
+     * @return true = 已扣或这笔预扣已落过（撞业务唯一键 = 成功回放）；
+     *         false = 台账不可用状态或所有桶余量不足（业务事实，调用方走兜底奖品）
+     * @throws com.betterschool.marketing.types.common.AppException           inv_id 查无此库存
+     * @throws com.betterschool.marketing.types.inventory.exception.BucketUnavailableException redis 故障
+     */
+    boolean preDeduct(InventorySegmentVO segment, long invId, long quantity, String bizType, long bizId);
+
+    /**
+     * 带兜底的预扣（spec §7.2）：主档扣不出 → 换个 inv_id（可换段）再扣；两段都扣不出 = FAILED。
+     * 配额段零写入由「兜底路径根本不碰配额仓储」保证——主档一旦扣不出就没有任何配额副作用。
+     *
+     * @param primary  主档请求（抽奖 = 实物营销配额）
+     * @param fallback 兜底请求（抽奖 = 兜底奖品的虚拟权益池）；null = 没有可扣的兜底库存
+     */
+    DeductOutcomeVO preDeductWithFallback(InventoryDeductRequestVO primary, InventoryDeductRequestVO fallback);
+
+    /**
+     * 兑换确认（仅实物段）：{@code waiting_qty → issued_qty} 守卫转移。
+     * 调用方只需保证「真的推进了发货状态的那一次」才来确认——库存侧按数量转移，不做单号去重。
+     *
+     * @param bizType {@code InventoryBizTypes.LOTTERY_CLAIM}
+     * @param bizId   抽奖记录 id（= {@code draw_record.record_id}），不是独立兑换单号
+     * @throws com.betterschool.marketing.types.common.AppException 配额不存在或 waiting_qty 不足本次确认量
+     */
+    void confirmIssued(long invId, String bizType, long bizId, long quantity);
+}
