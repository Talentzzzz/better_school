diff --git a/backend/better-school/bs-app/src/test/java/com/betterschool/integration/errand/ErrandFeedIndexRebuildIntegrationTest.java b/backend/better-school/bs-app/src/test/java/com/betterschool/integration/errand/ErrandFeedIndexRebuildIntegrationTest.java
