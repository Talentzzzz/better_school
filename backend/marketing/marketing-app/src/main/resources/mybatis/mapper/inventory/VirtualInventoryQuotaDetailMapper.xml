<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.betterschool.marketing.infrastructure.inventory.dao.IVirtualInventoryQuotaDetailDao">

    <!-- ============ 预扣落库（一组一事务，票 06） ============ -->

    <!-- 流水先行：批量 INSERT IGNORE 撞 uk_biz 时静默跳过，返回值 = 实际新增行数。
         新代码不写 state（列默认 0，D9 收口删列）与 bucket_id（桶层已删，列可空保留到 D9）；
         create_time/update_time 由 DB NOW() 写 -->
    <insert id="batchInsertIgnoreDeductDetails">
        INSERT IGNORE INTO virtual_inventory_quota_detail (inv_id, quantity, biz_type, biz_id,
                                                           create_time, update_time)
        VALUES
        <foreach collection="details" item="d" separator=",">
            (#{invId}, #{d.quantity}, #{d.bizType}, #{d.bizId}, NOW(), NOW())
        </foreach>
    </insert>

    <!-- 仅在批量 INSERT 后发现新增行数 &lt; 批大小时调用：捞回已存在的预扣行（它们的量已经扣过），
         调用方据此从本次扣减量里剔除。不按 inv_id 过滤：唯一键是全局的 (biz_type, biz_id) -->
    <select id="listExistingDeductDetails"
            resultType="com.betterschool.marketing.infrastructure.inventory.dao.po.VirtualInventoryQuotaDetailPO">
        SELECT biz_type, biz_id, quantity
        FROM virtual_inventory_quota_detail
        WHERE biz_type = #{bizType}
          AND biz_id IN
        <foreach collection="bizIds" item="bizId" separator="," open="(" close=")">
            #{bizId}
        </foreach>
    </select>

    <!-- 业务幂等预检（台账非 open 时的重放窗口）：本 inv 上 biz_type + biz_id 命中 = 已落过 -->
    <select id="existsDeductDetail" resultType="boolean">
        SELECT EXISTS(SELECT 1
                      FROM virtual_inventory_quota_detail
                      WHERE inv_id = #{invId} AND biz_type = #{bizType} AND biz_id = #{bizId})
    </select>

</mapper>
