<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.betterschool.marketing.infrastructure.points.dao.IPointsDetailDao">

    <!--
      幂等预检（快路径）：普通快照读，不带 FOR UPDATE。
      该查询在「这笔没扣过」时结果为空，加锁读加的只是间隙锁；而间隙锁彼此兼容、并不互斥，
      拦不住并发重复——它唯一的实际效果是在「空查 + 后续插入」这个 InnoDB 常见组合上埋下死锁
      （并发重复兑换的死锁正是从这条间隙锁开始的）。
      真正的互斥是 points_detail 的唯一键 uk_bucket_reason_ref：后到者 INSERT IGNORE 明细撞 uk 即整事务回滚，
      见下面的 insertIgnoreDetails。
    -->
    <select id="selectConsumeId" resultType="java.lang.Long">
        SELECT id
        FROM points_detail
        WHERE user_id = #{userId} AND reason_type = #{reasonType} AND ref_id = #{refId}
        LIMIT 1
    </select>

    <!--
      消费明细先行，且整笔只写一条语句：一条多值 INSERT IGNORE 写下方案里的全部明细，
      行数 = 被碰到的桶数（跨 1 个桶与跨 50 个桶都是这一条）。
      撞 uk_bucket_reason_ref 表现为「影响行数 &lt; 明细条数」——撞键的那一行被 IGNORE 掉、其余行照写，
      调用方拿影响行数与明细条数比对，不等即整笔回滚，语义与逐桶版一致
      （重复兑换 → 回滚 → 事务外重读余额按成功回报）。
    -->
    <insert id="insertIgnoreDetails">
        INSERT IGNORE INTO points_detail (user_id, bucket_id, amount, reason_type, ref_id, create_time, update_time)
        VALUES
        <foreach collection="details" item="detail" separator=",">
            (#{detail.userId}, #{detail.bucketId}, #{detail.amount}, #{detail.reasonType}, #{detail.refId},
            #{detail.createTime}, #{detail.updateTime})
        </foreach>
    </insert>

</mapper>
