<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.betterschool</groupId>
        <artifactId>marketing</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>marketing-app</artifactId>
    <name>marketing-app</name>
    <dependencies>
        <dependency>
            <groupId>com.betterschool</groupId>
            <artifactId>marketing-trigger</artifactId>
        </dependency>
        <dependency>
            <groupId>com.betterschool</groupId>
            <artifactId>marketing-infrastructure</artifactId>
        </dependency>
        <dependency>
            <groupId>com.betterschool</groupId>
            <artifactId>marketing-case</artifactId>
        </dependency>
        <dependency>
            <groupId>com.betterschool</groupId>
            <artifactId>marketing-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.betterschool</groupId>
            <artifactId>marketing-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>com.betterschool</groupId>
            <artifactId>marketing-types</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 执行器注册（appname/port/log-path 每个服务一套，见 spec「本地开发与构建」端口表） -->
        <dependency>
            <groupId>com.xuxueli</groupId>
            <artifactId>xxl-job-core</artifactId>
        </dependency>
        <!-- 配置中心：jwt.secret 与单体共用一份 better-school-shared.yml；
             没有它 nacos: 前缀的 spring.config.import 会落到 StandardConfigDataLocationResolver 直接启动失败 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 集成测试：连 scripts/test-env.sh 起好的常驻栈（bs_marketing_test 库），HTTP 走 trigger 层入口 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
