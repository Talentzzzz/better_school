<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.betterschool.infrastructure.dao.moderation.ISensitiveWordDao">

    <!-- 敏感词：uk_word 冲突 = 已存在（INSERT IGNORE 幂等） -->
    <insert id="insertIgnoreWord" parameterType="com.betterschool.infrastructure.dao.moderation.po.SensitiveWord"
            useGeneratedKeys="true" keyProperty="id">
        INSERT IGNORE INTO sensitive_word (word, enabled, create_time, update_time)
        VALUES (#{word}, #{enabled}, NOW(), NOW())
    </insert>

    <delete id="deleteWord">
        DELETE FROM sensitive_word
        WHERE id = #{wordId}
    </delete>

    <select id="selectEnabledWords" resultType="string">
        SELECT word
        FROM sensitive_word
        WHERE enabled = 1
    </select>

    <select id="selectWords" resultType="com.betterschool.infrastructure.dao.moderation.po.SensitiveWord">
        SELECT id, word, enabled, create_time, update_time
        FROM sensitive_word
        ORDER BY id DESC
        LIMIT #{offset}, #{limit}
    </select>

    <select id="countWords" resultType="long">
        SELECT COUNT(1)
        FROM sensitive_word
    </select>

</mapper>
