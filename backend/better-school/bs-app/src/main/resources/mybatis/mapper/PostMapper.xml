<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.betterschool.infrastructure.dao.post.IPostDao">

    <!-- like_count/comment_count/view_count 不在本 mapper 的任何 SELECT 里：三个计数窄表
         post_like_count / post_comment_count / post_view_count 由仓储按页内 id 集批量回查
         （IPostLikeCountDao / IPostCommentCountDao / IPostViewCountDao），作者昵称头像由仓储查 bs_user 回填——SQL 层零 JOIN。
         post 行不再存计数列，也不刷新 view_count（feed-index-uv 票 02 起停写停读，
         浏览 UV 的真相源是 user_view_history，加速列 post_view_count）。
         点赞关系 / 浏览历史 / feed 索引语句分别在 PostLikeMapper / UserViewHistoryMapper / PostFeedIndexMapper -->
    <sql id="postColumns">
        id, post_id, user_id, title, content, images, cover, state,
        create_time
    </sql>

    <!-- 时刻一律数据库时钟：create_time/update_time=NOW()；发布行 expire_at=NOW()+30d（与 submitDraft
         同口径）；草稿行 expire_at 保持 NULL（提交时才锚定） -->
    <insert id="insert" parameterType="com.betterschool.infrastructure.dao.post.po.Post"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO post (post_id, user_id, title, content, images, cover, state,
                          create_time, update_time, expire_at)
        VALUES (#{postId}, #{userId}, #{title}, #{content}, #{images}, #{cover}, #{state},
                NOW(), NOW(), IF(#{state} = 'DRAFT', NULL, DATE_ADD(NOW(), INTERVAL 30 DAY)))
    </insert>

    <!-- 布隆过滤器预热：一次性取全量（不是循环），刻意不设限 -->
    <select id="selectAllIds" resultType="string">
        SELECT post_id FROM post
    </select>

    <!-- 全量重建游标：业务 ID 是 UUID 字符串，按 post_id 字典序推进（同一排序规则下 &gt; 与 ORDER BY 自洽） -->
    <select id="selectIdsAfter" resultType="string">
        SELECT post_id FROM post
        WHERE post_id &gt; #{lastId}
        ORDER BY post_id
        LIMIT #{limit}
    </select>

    <!-- 详情内容查询（票 05 读路径拆两段之一）：只取正文/状态/作者外键/配图，进缓存；
         不带计数——三个计数由仓储按窄表批量回查，缓存里永远没有计数；作者昵称头像同样仓储回查 -->
    <select id="selectById" resultType="com.betterschool.infrastructure.dao.post.po.Post">
        SELECT <include refid="postColumns"/>
        FROM post
        WHERE post_id = #{postId}
          AND state != 'DELETED'
    </select>

    <!-- 覆盖草稿内容（全量编辑：文字、图片、封面全部可改，仅 DRAFT 行生效） -->
    <update id="updateDraft" parameterType="com.betterschool.infrastructure.dao.post.po.Post">
        UPDATE post
        SET title    = #{title},
            content  = #{content},
            images   = #{images},
            cover    = #{cover},
            update_time = NOW()
        WHERE post_id = #{postId}
          AND state = 'DRAFT'
    </update>

    <!-- 提交草稿：DRAFT → NORMAL（直接发布对外可见）；同步刷新过期时间 -->
    <update id="submitDraft">
        UPDATE post
        SET state             = 'NORMAL',
            expire_at         = DATE_ADD(NOW(), INTERVAL 30 DAY),
            update_time       = NOW()
        WHERE post_id = #{postId}
          AND state = 'DRAFT'
    </update>

    <!-- 按 id 列表查询：不分状态（搜索同步按 state 判定 upsert/删除，搜索命中组装按 NORMAL 过滤）。
         纯 post 单表：计数/作者由仓储批量回查拼装 -->
    <select id="selectByIds" resultType="com.betterschool.infrastructure.dao.post.po.Post">
        SELECT <include refid="postColumns"/>
        FROM post
        WHERE post_id IN
        <foreach collection="ids" item="postId" open="(" separator="," close=")">#{postId}</foreach>
    </select>

    <update id="softDelete">
        UPDATE post
        SET state = 'DELETED',
            update_time = NOW()
        WHERE post_id = #{postId}
          AND state != 'DELETED'
    </update>

    <!-- 旧直查路径（feed-index-uv 票 04 起仅作降级，票 06 分类退役后索引路径为主路径）：
         time 档纯 post 单表 SQL 分页；hot 档排序键 like_count 在窄表里（不能 JOIN 进来），
         由仓储走 selectNormalRows 取全集 + 窄表批量回查 + 内存排序切片（降级路径，数据集有界） -->
    <select id="selectPage" resultType="com.betterschool.infrastructure.dao.post.po.Post">
        SELECT <include refid="postColumns"/>
        FROM post
        WHERE state = 'NORMAL'
        ORDER BY create_time DESC, post_id DESC
        LIMIT #{offset}, #{limit}
    </select>

    <!-- hot 档降级取数：NORMAL 全集（无 LIMIT），排序与切片在仓储内存完成 -->
    <select id="selectNormalRows" resultType="com.betterschool.infrastructure.dao.post.po.Post">
        SELECT <include refid="postColumns"/>
        FROM post
        WHERE state = 'NORMAL'
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(1)
        FROM post
        WHERE state = 'NORMAL'
    </select>

    <!-- 我的帖子分页（作者视角）：NORMAL + 草稿，排除已删除 -->
    <select id="selectPageByUser" resultType="com.betterschool.infrastructure.dao.post.po.Post">
        SELECT <include refid="postColumns"/>
        FROM post
        WHERE user_id = #{userId}
          AND state IN ('NORMAL', 'DRAFT')
        ORDER BY create_time DESC, post_id DESC
        LIMIT #{offset}, #{limit}
    </select>

    <select id="countByUser" resultType="long">
        SELECT COUNT(1)
        FROM post
        WHERE user_id = #{userId}
          AND state IN ('NORMAL', 'DRAFT')
    </select>

    <!-- 某用户的公开帖子（作者主页「笔记」tab）：仅 NORMAL；本人看自己也走此口径（草稿只在「我的」页） -->
    <select id="selectNormalPageByUser" resultType="com.betterschool.infrastructure.dao.post.po.Post">
        SELECT <include refid="postColumns"/>
        FROM post
        WHERE user_id = #{userId}
          AND state = 'NORMAL'
        ORDER BY create_time DESC, post_id DESC
        LIMIT #{offset}, #{limit}
    </select>

    <select id="countNormalByUser" resultType="long">
        SELECT COUNT(1)
        FROM post
        WHERE user_id = #{userId}
          AND state = 'NORMAL'
    </select>

    <!-- 某用户全部 NORMAL 帖 id 集（获赞统计取数①：个人资料页的 receivedLikeCount，idUserRepository
         拿它回查 post_like_count 窄表求和，SQL 层零 JOIN；只取 id 列，行数 = 该用户公开帖数） -->
    <select id="selectNormalIdsByUser" resultType="string">
        SELECT post_id
        FROM post
        WHERE user_id = #{userId}
          AND state = 'NORMAL'
    </select>

    <!-- feed 索引全量重建的取数①（feed-index-uv 票 07）：主表 post。重灌行集 = NORMAL 帖
         （运行期语义：发布事务才诞生行，之后 state 跟随流转、行不消失；草稿帖不凭空进索引）。
         原 INSERT..SELECT 一步投影改为仓储多查拼装：① selectRebuildRows 取 post 全量 (post_id, state, create_time)，
         feed_time = create_time；② like_count 从窄表批量抄入（无行 = 0，与运行期「窄表无行即计数 0」同口径），
         组装成行集后走 IPostFeedIndexDao.insertFeedIndexRows 批量写入 -->
    <select id="selectRebuildRows" resultType="com.betterschool.infrastructure.dao.post.po.PostFeedIndexRow">
        SELECT post_id, state, create_time
        FROM post
    </select>

</mapper>
