<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.betterschool.infrastructure.dao.raffle.IDrawRecordDetailDao">

    <!-- 只插入语义：撞 uk_record_type 返回 0 = 该记录该动作已落过 -->
    <insert id="insertIgnoreRecordDetail"
            parameterType="com.betterschool.infrastructure.dao.raffle.po.DrawRecordDetailPO">
        INSERT IGNORE INTO draw_record_detail (user_id, record_id, type, create_time, update_time)
        VALUES (#{userId}, #{recordId}, #{type}, #{createTime}, #{updateTime})
    </insert>

    <!-- 兑换动作明细批量读（draw_record_detail 单表；该表原本只有 insert，这是第一条单表查询语句） -->
    <select id="selectExchangeDetailsByRecordIds" resultType="com.betterschool.infrastructure.dao.raffle.po.ExchangeDetailRowPO">
        SELECT record_id AS recordId, create_time AS createTime
        FROM draw_record_detail
        WHERE type = 'EXCHANGE'
          AND record_id IN
        <foreach collection="recordIds" item="recordId" open="(" separator="," close=")">#{recordId}</foreach>
    </select>

</mapper>
