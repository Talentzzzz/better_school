<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.betterschool.infrastructure.dao.draw.IDrawStrategyWeightDao">

    <select id="selectWeightListByStrategyId"
            resultType="com.betterschool.infrastructure.dao.draw.po.DrawStrategyWeightPO">
        SELECT id, strategy_id, count, weights, create_time, update_time
        FROM draw_strategy_weight
        WHERE strategy_id = #{strategyId}
        ORDER BY count ASC
    </select>

</mapper>
