<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.betterschool.infrastructure.dao.inventory.IVirtualInventoryQuotaDao">

    <!-- ============ 台账（外界投放配额池：只被「分配」转出，抽奖不直接扣减） ============ -->

    <!-- 库存行（不限 state；open 与否则由域服务校验） -->
    <select id="selectInventory" resultType="com.betterschool.infrastructure.dao.inventory.po.VirtualInventoryQuotaPO">
        SELECT id, inv_id, name, type, value, surplus_qty, issued_qty, state, create_time, update_time
        FROM virtual_inventory_quota
        WHERE inv_id = #{invId}
    </select>

    <!-- 分配扣减（池侧守卫转出，InventoryRepository#allocate 的事务步）：
         state='open' 且 (surplus < 0 OR surplus >= N) 守卫下转出；-1=不限量：放行、不动 surplus。
         注意 surplus 不置 exhausted 也不写池明细（分配不产生 issued 流转，守恒靠分配流水表） -->
    <update id="deductForAllocate">
        UPDATE virtual_inventory_quota
        SET surplus_qty = IF(surplus_qty &lt; 0, surplus_qty, surplus_qty - #{quantity}),
            update_time = NOW()
        WHERE inv_id = #{invId} AND state = 'open'
          AND (surplus_qty &lt; 0 OR surplus_qty &gt;= #{quantity})
    </update>

    <!-- ============ 预热 ============ -->

    <!-- 预热入口：全部 open 的虚拟库存 -->
    <select id="selectOpenInventories" resultType="com.betterschool.infrastructure.dao.inventory.po.VirtualInventoryQuotaPO">
        SELECT id, inv_id, name, type, value, surplus_qty, issued_qty, state, create_time, update_time
        FROM virtual_inventory_quota
        WHERE state = 'open'
    </select>

    <!-- ============ 奖品目录 / 中奖记录读侧（票 13，语句自 RaffleMapper 按主表归属迁入） ============ -->

    <!-- 面额只对积分台账有意义（DRAW_COUNT 型库存不放这个字段）；
         award-inventory 两层模型起池仍是「面额配置」的真相所在（奖品库存账户只存 value_qty 数值，
         不冗余 POINTS/DRAW_COUNT 区分），目录/记录视图的 pointsAmount 仍从这里拼 -->
    <select id="selectPointsValueByInvId" resultType="java.lang.Integer">
        SELECT value
        FROM virtual_inventory_quota
        WHERE inv_id = #{invId} AND type = 'POINTS'
    </select>

    <!--
        虚拟台账批量读（invId → type/value）：award-inventory 两层模型起 remaining/total 改读
        奖品库存账户（draw_strategy_award_inventory），本查询只剩 pointsAmount 的面额配置拼装源
        （type=POINTS 的池才有积分面额）。
    -->
    <select id="selectVirtualQuotasByInvIds" resultType="com.betterschool.infrastructure.dao.raffle.po.VirtualQuotaRowPO">
        SELECT inv_id AS invId, type, value, surplus_qty AS surplusQty, issued_qty AS issuedQty
        FROM virtual_inventory_quota
        WHERE inv_id IN
        <foreach collection="invIds" item="invId" open="(" separator="," close=")">#{invId}</foreach>
    </select>

    <!-- 积分面额批量读：仅 type=POINTS 的虚拟台账行（面额只对积分台账有意义，DRAW_COUNT 型不放这个字段） -->
    <select id="selectPointValuesByInvIds" resultType="com.betterschool.infrastructure.dao.raffle.po.VirtualQuotaRowPO">
        SELECT inv_id AS invId, value
        FROM virtual_inventory_quota
        WHERE type = 'POINTS'
          AND inv_id IN
        <foreach collection="invIds" item="invId" open="(" separator="," close=")">#{invId}</foreach>
    </select>

</mapper>
