<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.betterschool.infrastructure.dao.draw.IDrawStrategyDao">

    <select id="selectStrategyByStrategyId"
            resultType="com.betterschool.infrastructure.dao.draw.po.DrawStrategyPO">
        SELECT id, strategy_id, strategy_desc, rule, create_time, update_time
        FROM draw_strategy
        WHERE strategy_id = #{strategyId}
    </select>

</mapper>
