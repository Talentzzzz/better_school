<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.betterschool.infrastructure.dao.comment.IPostCommentDao">

    <sql id="baseColumns">
        id, comment_id, post_id, user_id, content, state, root_id, parent_id, reply_count,
        create_time
    </sql>

    <!-- 各语句统一纯 post_comment 单表列清单：作者昵称（bs_user）、
         楼内的指向评论（post_comment 父行自连）、主页 tab 的来源帖标题封面（post）均由仓储二次回查拼装
         （SQL 层零 JOIN）。like_count 不在列清单里（票 02）：真源在 post_comment_like_count，
         由仓储按页内 id 集批量回查填充。评论点赞关系 / 点赞计数窄表 / 热评索引 / 评论计数窄表语句分别在
         PostCommentLikeMapper / PostCommentLikeCountMapper / PostCommentFeedIndexMapper / PostCommentCountMapper -->

    <insert id="insert" parameterType="com.betterschool.infrastructure.dao.comment.po.PostComment"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO post_comment (comment_id, post_id, user_id, content, state, root_id, parent_id, create_time, update_time)
        VALUES (#{commentId}, #{postId}, #{userId}, #{content}, #{state}, #{rootId}, #{parentId}, NOW(), NOW())
    </insert>

    <!-- 根评论列表（默认档 / sort=new）：只查 root_id='0'；仅 NORMAL 公开。
         排序 = create_time 升序 + 业务 ID 升序（uuid-biz-id 票 03：业务 ID 是 UUID、无序，发布时间先后由
         create_time 表达，业务 ID 只做同值收敛）；最热档不走这条——它在 post_comment_feed_index 上两级取数
         （见 IPostCommentFeedIndexDao.selectRootFeedCommentIds），顺序来自索引 -->
    <select id="selectRootPageByPostId" resultType="com.betterschool.infrastructure.dao.comment.po.PostComment">
        SELECT <include refid="baseColumns"/>
        FROM post_comment
        WHERE post_id = #{postId}
          AND root_id = '0'
          AND state = 'NORMAL'
        ORDER BY create_time, comment_id
        LIMIT #{offset}, #{limit}
    </select>

    <!-- 最热档第二步：按 id 集回查评论行（纯单表，与默认档同列清单；作者昵称/驳回理由仓储拼装）。
         顺序由调用方按扫描序重排，本语句不排序；只取 NORMAL 根行——索引行集本应与之一致，
         漂移（索引行未随软删退场）时缺行由调用方跳过，不补位 -->
    <select id="selectNormalRootsByIds" resultType="com.betterschool.infrastructure.dao.comment.po.PostComment">
        SELECT <include refid="baseColumns"/>
        FROM post_comment
        WHERE comment_id IN
        <foreach collection="commentIds" item="commentId" open="(" separator="," close=")">#{commentId}</foreach>
          AND root_id = '0'
          AND state = 'NORMAL'
    </select>

    <!-- 根评论真实总数：他人可见口径（仅 NORMAL 根评论，不含任何待审） -->
    <select id="countVisibleRootsByPostId" resultType="long">
        SELECT COUNT(*)
        FROM post_comment
        WHERE post_id = #{postId}
          AND root_id = '0'
          AND state = 'NORMAL'
    </select>

    <!-- 楼内子回复平铺：按 root_id 归组、create_time 升序 + 业务 ID 升序、仅 NORMAL；
         指向评论行（reply_to_*）由仓储按 parent_id 集单表回查拼装、忽略其状态
         （被指向评论被删时昵称仍可读）。
         like_count 不在列清单里（票 02，真源在 post_comment_like_count，仓储批量回查填充）；
         reply_count 只对根评论有意义，楼内不取 -->
    <select id="selectRepliesByRootId" resultType="com.betterschool.infrastructure.dao.comment.po.PostComment">
        SELECT <include refid="baseColumns"/>
        FROM post_comment
        WHERE root_id = #{rootId}
          AND state = 'NORMAL'
        ORDER BY create_time, comment_id
        LIMIT #{offset}, #{limit}
    </select>

    <!-- 楼内可见子回复总数（仅 NORMAL，与分页口径一致） -->
    <select id="countRepliesForThread" resultType="long">
        SELECT COUNT(*)
        FROM post_comment
        WHERE root_id = #{rootId}
          AND state = 'NORMAL'
    </select>

    <select id="countRepliesByRootId" resultType="long">
        SELECT COUNT(*)
        FROM post_comment
        WHERE root_id = #{rootId}
          AND state = 'NORMAL'
    </select>

    <update id="updateReplyCount">
        UPDATE post_comment
        SET reply_count = GREATEST(0, reply_count + #{delta}),
            update_time = NOW()
        WHERE comment_id = #{rootId}
    </update>

    <!-- 按用户列评论（作者主页「评论」tab）：该用户的全部 NORMAL 评论行（单表，按评论时间倒序），
         源帖 NORMAL 过滤与来源帖标题/封面（评论行不存）由仓储回查 post 拼装
         （用户自己的评论行有界，total = 过滤后集合大小，与原 JOIN COUNT 同口径）。
         like_count 不在列清单里（票 02，真源在 post_comment_like_count，仓储批量回查填充） -->
    <select id="selectNormalRowsByUser" resultType="com.betterschool.infrastructure.dao.comment.po.PostComment">
        SELECT <include refid="baseColumns"/>
        FROM post_comment
        WHERE user_id = #{userId}
          AND state = 'NORMAL'
        ORDER BY create_time DESC, comment_id DESC
    </select>

    <!-- 单条评论（点赞前置检查、详情组装）。like_count 不在列清单里（票 02）：
         真源在 post_comment_like_count，仓储按单元素 id 集同一条回查通路填充 -->
    <select id="selectById" resultType="com.betterschool.infrastructure.dao.comment.po.PostComment">
        SELECT <include refid="baseColumns"/>
        FROM post_comment
        WHERE comment_id = #{commentId}
    </select>

    <!-- 按 id 集批量回查（不分状态：楼内指向评论回查要忽略父行状态） -->
    <select id="selectByIds" resultType="com.betterschool.infrastructure.dao.comment.po.PostComment">
        SELECT <include refid="baseColumns"/>
        FROM post_comment
        WHERE comment_id IN
        <foreach collection="ids" item="commentId" open="(" separator="," close=")">#{commentId}</foreach>
    </select>

    <!-- 我评论过的帖子（PostMapper 迁入）：去重 + 最近评论时间倒序（单表 GROUP BY，ONLY_FULL_GROUP_BY 安全）；
         帖子行与可见性过滤由仓储两段查拼装 -->
    <select id="selectRelationCommentedRows" resultType="com.betterschool.infrastructure.dao.post.po.PostRelationRow">
        SELECT post_id
        FROM post_comment
        WHERE user_id = #{userId}
          AND state = 'NORMAL'
        GROUP BY post_id
        ORDER BY MAX(create_time) DESC, post_id DESC
    </select>

    <!-- 统一软删：用户删除与举报下架同轨，状态转 DELETED、行保留（物理 DELETE 已废弃）。
         仅指定前置状态可翻转：DELETED 终态不翻；扣减计数与否由实际命中的前置状态决定 -->
    <update id="markDeletedFromStatus">
        UPDATE post_comment
        SET state = 'DELETED',
            update_time = NOW()
        WHERE comment_id = #{commentId}
          AND state = #{fromStatus}
    </update>

    <!-- 根/子判定：写路径只拿到 commentId，赞合并与软删要靠它决定要不要碰索引。
         子回复（root_id != '0'）的索引 UPDATE 必然 0 行，绝不能当漂移告警 -->
    <select id="selectRootId" resultType="string">
        SELECT root_id
        FROM post_comment
        WHERE comment_id = #{commentId}
    </select>

    <!-- ── 热评索引全量重建的取数①（票 03）：主表 post_comment。重灌：根评论一行 1:1 投影，
         行集 = root_id = '0' AND state = 'NORMAL'（与运行期口径一致：发布即诞生、
         软删物理退场，所以没有 state 列要投影）。这条 state 判据的前提是「评论软删是终态、没有恢复路径」——
         原文来自 spec §2.2 的建表理由；将来若给评论开恢复路径，这张表的行集语义与这条 SQL 要一起改。
         原 INSERT..SELECT 一步投影改为仓储多查拼装：① selectRebuildRows 取根评论行（createTime = 评论 create_time）；
         ② like_count 从计数窄表抄入（无行 = 0，与运行期「窄表无行即计数 0」同口径）；
         组装后走 IPostCommentFeedIndexDao.insertFeedIndexRows 批量写回。update_time 每次重建刷 NOW()：技术时间戳、非排序键 -->
    <select id="selectRebuildRows" resultType="com.betterschool.infrastructure.dao.comment.po.CommentFeedIndexRow">
        SELECT comment_id, post_id, create_time
        FROM post_comment
        WHERE root_id = '0'
          AND state = 'NORMAL'
    </select>

</mapper>
