<?xml version="1.0" encoding="UTF-8"?>
<!--
  虚拟线程常态化观测配置（virtual-thread effort 票 16，spec §5.1）。

  基底 = .scratch/virtual-thread/measure/vt-pin-only.jfc（那份只含一个事件、不能直接复用），
  本文件在其上补线程统计事件。⚠️ jdk.VirtualThreadPinned 的 threshold 必须留在 0 ms——
  default.jfc 的 20 ms 会把短 pin 漏掉（票 03/04 实测该阈值下只能收到 1.8% 的 JDBC pin 事件）。

  disk / filename / maxsize / maxage 等 recording 参数不在本文件里，由启动参数给
  （backend/scripts/run-app.sh 是唯一入口）。
-->
<configuration version="2.0" label="BS VT observability" description="jdk.VirtualThreadPinned @0ms + 平台线程统计/生命周期" provider="Custom">

  <!-- pinning：本 recording 存在的理由。0ms 阈值。 -->
  <event name="jdk.VirtualThreadPinned">
    <setting name="enabled">true</setting>
    <setting name="stackTrace">true</setting>
    <setting name="threshold">0 ms</setting>
  </event>

  <!-- 平台线程数时序（activeCount / peakCount / startedCount），供 spec §5.1 的「分路径看平台线程数」取数 -->
  <event name="jdk.JavaThreadStatistics">
    <setting name="enabled">true</setting>
    <setting name="period">1000 ms</setting>
  </event>

  <!-- 平台线程生命周期：能看出 ConsumeMessageThread_* / http-nio-* 是否曾出现、从哪起 -->
  <event name="jdk.ThreadStart">
    <setting name="enabled">true</setting>
    <setting name="stackTrace">true</setting>
  </event>
  <event name="jdk.ThreadEnd">
    <setting name="enabled">true</setting>
  </event>

  <!-- 虚拟线程投递失败留痕：无界 executor 只在 shutdown 之后拒绝，正常只覆盖停机窗口 -->
  <event name="jdk.VirtualThreadSubmitFailed">
    <setting name="enabled">true</setting>
    <setting name="stackTrace">true</setting>
  </event>

  <!--
    刻意不开 jdk.VirtualThreadStart / jdk.VirtualThreadEnd：每创建一条 VT 就记一条，
    常驻 recording 下体量爆炸。要看「有哪些虚拟线程在跑」用 jcmd Thread.dump_to_file
    （票 14 的口径），那才是读物。
  -->
</configuration>
